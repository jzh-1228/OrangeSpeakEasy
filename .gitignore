# 密钥与本地环境变量（示例文件照常入库）
.env
.env.*
!.env.example

# 本机配置：凭据名、加载器路径、GitHub 账号，每台机器不一样（样板 .machine.env.example 照常入库）
.machine.env

# 系统与编辑器
.DS_Store
.idea/
.vscode/
*.swp

# 浏览器自动化（playwright MCP）的截图与日志
.playwright-mcp/

# Claude Code 本机设置（里面的自动记忆目录是本机绝对路径）
.claude/settings.local.json

# 本机代理工具的工作目录（网页/视频复刻、任务令牌），不随仓库走
.v2c/
.video_agent/

# 逆向目标的工作目录：拆出来的原始代码、抓包、本机数据副本，一律不进仓库
targets/*/_work/
# 评测的工作目录：洗好的录音、下载的模型、结果库和报告，里面有说过的话
bench/_work/
*.har
*.pcap
*.pcapng
*.mitm

# 项目局部的分析引擎（Ghidra 等），体积大且可重新下载
.tools/

# 各子项目自己装的依赖，靠锁文件还原
node_modules

# 打 Windows 安装程序时临时生成的资源文件（scripts/build/windows-setup.mjs 编完就删）
native/windows-setup/*.syso
# OrangeSpeakEasy 本机编译出来的原生小程序和打出来的应用（只认仓库根下的这两个目录）
/build/
/dist/
# 官网构建出来的静态页
website/dist/

# 下载量观测的缓存（scripts/ops/stats.mjs）：CDN 访问日志里有真实用户的 IP，自己的出口只存哈希，都不进仓库
/.stats/

# Claude Code 给子任务临时建的工作副本
.claude/worktrees/
__pycache__/
