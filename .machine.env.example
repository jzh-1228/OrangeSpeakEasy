# 本机配置的样板。抄一份改名成 .machine.env，填上自己机器的情况；.machine.env 不进 git。
#
# 这里只放"名字"和"路径"，不放密钥本身——密钥留在你自己的凭据存放处。
# 仓库里的脚本和协作记忆都只认下面这几个变量名，不认任何一台机器上的具体值。

# ---- 开发时各家模型的 key 从哪来 ----
# 跑端到端测试、评估脚本这类要真调模型的命令时，统一写成：
#   scripts/dev/with-key.sh <gemini|openai|deepseek|bailian|moonshot> <命令…>
# 环境里已经有那一家的 key（GEMINI_API_KEY、OPENAI_API_KEY、DEEPSEEK_API_KEY、BAILIAN_API_KEY、MOONSHOT_API_KEY、ZHIPU_API_KEY、MINIMAX_API_KEY）时它直接用，下面几项可以留空。
# bailian 是阿里云百炼（国内站），凭据里定义 BAILIAN_API_KEY；moonshot 是 Kimi 官方开放平台，凭据里定义 MOONSHOT_API_KEY；
# zhipu、minimax 是智谱、MiniMax 的开放平台（国内站），凭据里定义 ZHIPU_API_KEY、MINIMAX_API_KEY。
# 用"按需加载器"（一个定义了 `withkey <凭据名> <命令…>` 的 shell 脚本）管密钥的话，填加载器和各家的凭据名：
SECRETS_LOADER=
GEMINI_CREDENTIAL=
OPENAI_CREDENTIAL=
DEEPSEEK_CREDENTIAL=
BAILIAN_CREDENTIAL=
MOONSHOT_CREDENTIAL=
ZHIPU_CREDENTIAL=
MINIMAX_CREDENTIAL=

# ---- 本项目的 GitHub 操作用哪个账号 ----
# 一台机器上登录了多个账号时，push 之前用 scripts/checks/check-gh-account.sh 核对。只有一个账号可以留空。
GITHUB_ACCOUNT=

# ---- 本项目的提交用哪个邮箱 ----
# 不想让平时用的邮箱出现在公开的提交里，就在这里填一个专门的（比如 GitHub 的匿名邮箱），
# 并在仓库里执行 git config user.email <它>。scripts/checks/check-no-machine-facts.sh 会核对。不在意可以留空。
GIT_EMAIL=

# ---- 发布包传到哪个 COS 桶、密钥从哪来 ----
# 只有往下载地址上发布新版本的人才用得到：npm run ship（上传那一步经 scripts/release/with-cos-key.sh 取密钥）
# 桶名带着账号的编号，所以放在这里而不是仓库里。
COS_BUCKET=
COS_REGION=
# 环境里已经有 TENCENTCLOUD_SECRET_ID 和 TENCENTCLOUD_SECRET_KEY 时直接用，下面两项可以留空。
# 用按需加载器管密钥的话填凭据名；这份凭据的加载器和上面的 SECRETS_LOADER 不是同一个时再填 COS_SECRETS_LOADER。
COS_CREDENTIAL=
COS_SECRETS_LOADER=
# 官网的截图传到哪个桶（website/scripts/upload-media.mjs，同样经 with-cos-key.sh 取密钥，地域用上面的 COS_REGION）。
# 只有要更新官网图片的人才用得到；和发布包的桶分开，私有，只让 CDN 读。
SITE_MEDIA_BUCKET=

# ---- 本地转写模型的国内源：魔搭（ModelScope）----
# 只有要往魔搭上传模型的人才用得到（npm run sync-models，经 scripts/release/with-modelscope-key.sh 取令牌）。
# 环境里已经有 MODELSCOPE_API_TOKEN 时直接用；用按需加载器（上面的 SECRETS_LOADER）管密钥的话填凭据名。
MODELSCOPE_CREDENTIAL=

# ---- 打 .app 时用哪张证书签名、拿什么公证 ----
# 只有要打签了名、能发给别人的 OrangeSpeakEasy.app 时才用得到（npm run dist、npm run install-app）。都留空时打出来的是
# 不带身份的本机签名，只能在这台机器上用，每次重新打包权限都要重给。这里只填名字，不填密钥：
#   证书先导进登录钥匙串：security import <证书>.p12 -k ~/Library/Keychains/login.keychain-db -T /usr/bin/codesign
#   名字照 security find-identity -v -p codesigning 列出来的填，带空格就加双引号，比如 "Developer ID Application: 名字 (团队号)"
MAC_SIGNING_IDENTITY=
# 公证用 App Store Connect 的 API key，先存进钥匙串，这里填存的时候起的档案名。留空就只签名、不公证：
#   xcrun notarytool store-credentials <档案名> --key AuthKey_<Key ID>.p8 --key-id <Key ID> --issuer <Issuer ID>
MAC_NOTARY_PROFILE=

# ---- 官网部署到哪台服务器（website/scripts/deploy.sh）----
# 只有要部署官网的人才用得到。SITE_SSH_HOST 是 ssh 的主机名或 ~/.ssh/config 里的别名（要能免密登录、能跑 docker）；
# SITE_REMOTE_DIR 是服务器上的部署目录，写绝对路径；服务器在大陆时 SITE_NPM_REGISTRY 填国内的 npm 源，构建快得多。
SITE_SSH_HOST=
SITE_REMOTE_DIR=
SITE_NPM_REGISTRY=

# ---- Windows 开发机（scripts/dev/win.sh、win-sync.sh）----
# 只有要在真 Windows 上开发、测试的人才用得到。WIN_SSH_TARGET 写成 用户名@地址（要能用钥匙免密登录，
# 管理员账号的公钥放在 C:\ProgramData\ssh\administrators_authorized_keys）；WIN_SSH_KEY 是那把私钥的路径
WIN_SSH_TARGET=
WIN_SSH_KEY=
